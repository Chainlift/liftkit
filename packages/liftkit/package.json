{
  "name": "liftkit",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "LiftKit: components built on Base UI with golden-ratio scaling, optical correction, and Material-based color.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chainlift/liftkit.git",
    "directory": "packages/liftkit"
  },
  "homepage": "https://github.com/Chainlift/liftkit#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./css/*": "./src/css/*"
  },
  "scripts": {
    "build": "tsdown && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0"
  },
  "devDependencies": {
    "@csstools/normalize.css": "^12.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsdown": "^0.23.7",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./*": {
        "types": "./dist/components/*/*.d.ts",
        "import": "./dist/components/*/*.js"
      }
    }
  }
}
